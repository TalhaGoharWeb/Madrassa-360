# ════════════════════════════════════════════════════════════════════════════
#  MADRASA 360 — SUPABASE CREDENTIALS TEMPLATE
#  ──────────────────────────────────────────────────────────────────────────
#  Copy this file to  assets/.env  and fill in the values for the new
#  madrassa's Supabase project.
#
#  NEVER commit assets/.env to version control.
#  The .gitignore already excludes it.
#
#  HOW TO GET THESE VALUES
#  ────────────────────────
#  1. Go to https://supabase.com → your project
#  2. Settings → API
#  3. Copy "Project URL" → SUPABASE_URL
#  4. Copy "anon / public" key → SUPABASE_ANON_KEY
# ════════════════════════════════════════════════════════════════════════════

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
